Checks: '-*,readability-identifier-naming,modernize-use-nullptr,modernize-use-override,performance-*,portability-*,bugprone-*,clang-analyzer-*'
WarningsAsErrors: ''
HeaderFilterRegex: '^(?!.*(vexv5|vex)).*'
FormatStyle: none
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase